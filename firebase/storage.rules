// RETIRED. Firebase Storage is no longer used by the app (files moved to Cloudinary and Supabase;
// see docs/PHASE4B_FILE_STORAGE.md). This file is kept only so the old rules stay on record, and firebase.json
// no longer deploys it. Existing files in the old bucket were NOT deleted, and old links keep working.

rules_version = '2';

// Cloud Storage for Firebase rules. Cloud Storage requires the Blaze (pay-as-you-go)
// plan. Without it, set "storage": false in src/config/features.json and use image
// URLs / bundled /images files instead.
//
// Roles are read from Firestore users/{uid}.roles (falls back to the legacy .role).

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function roles() { return profile().get('roles', [profile().role]); }
    function active() { return signedIn() && profile().status == 'active'; }
    function inRoles(rs) { return active() && roles().hasAny(rs); }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp|gif)'); }
    function isAudio() { return request.resource.contentType.matches('audio/(mpeg|mp3|mp4|x-m4a|m4a|aac|wav|x-wav|ogg|webm)'); }
    function isVideo() { return request.resource.contentType.matches('video/(mp4|webm|quicktime)'); }
    // Per-kind size caps: image 10 MB, document 25 MB, audio 50 MB, video 100 MB.
    function sizeOk() {
      return (isImage() && request.resource.size < 10 * 1024 * 1024)
          || (isDoc() && request.resource.size < 25 * 1024 * 1024)
          || (isAudio() && request.resource.size < 50 * 1024 * 1024)
          || (isVideo() && request.resource.size < 100 * 1024 * 1024);
    }
    function isDoc() {
      return request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/(msword|vnd.openxmlformats-officedocument.*|vnd.ms-powerpoint|vnd.ms-excel)')
          || request.resource.contentType.matches('text/plain');
    }

    // Website media library (CMS)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if inRoles(['super_admin', 'admin', 'cms_editor', 'cms_author'])
                   && sizeOk();
      allow delete: if inRoles(['super_admin', 'admin', 'cms_editor']);
    }
    // Student passport photographs
    match /students/{studentId}/{allPaths=**} {
      allow read: if inRoles(['super_admin', 'director', 'principal', 'admin', 'admissions', 'finance', 'teacher']);
      allow write: if inRoles(['super_admin', 'admin', 'principal', 'admissions'])
                   && request.resource.size < 2 * 1024 * 1024 && isImage();
    }
    // Course thumbnails, lesson videos/PDFs/attachments
    match /lms/{courseId}/{allPaths=**} {
      allow read: if active();
      allow create, update: if inRoles(['super_admin', 'admin', 'principal', 'teacher'])
                            && sizeOk();
      allow delete: if inRoles(['super_admin', 'admin', 'principal', 'teacher']);
    }
    // Assignment submissions: owner + academic staff
    match /submissions/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || inRoles(['super_admin', 'admin', 'principal', 'teacher']));
      allow write: if signedIn() && request.auth.uid == uid && active()
                   && request.resource.size < 10 * 1024 * 1024 && (isImage() || isDoc());
    }
    // CBT question images
    match /cbt/{allPaths=**} {
      allow read: if active();
      allow write: if inRoles(['super_admin', 'admin', 'principal', 'teacher'])
                   && request.resource.size < 3 * 1024 * 1024 && isImage();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
