# ---------------------------------------------------------------------------
# Episteme Learning Academy — environment configuration
# Copy to .env (local) — NEVER commit .env.
# For GitHub Pages, put the same values in GitHub → Settings → Secrets and
# variables → Actions → *Variables* (see README).
#
# NOTE: Firebase *web* config values are public identifiers, not secrets.
# Security comes from Firestore/Storage rules + Auth. Still, restrict the API key
# to your website's HTTP referrers in Google Cloud Console (see README).
# ---------------------------------------------------------------------------

# Option A (easiest on mobile): ONE variable containing the whole web config JSON
# (Firebase console → Project settings → Your apps → Web app → SDK config).
# VITE_FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Option B: individual values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=episteme-learning-academy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=episteme-learning-academy
VITE_FIREBASE_STORAGE_BUCKET=episteme-learning-academy.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=476274489231
VITE_FIREBASE_APP_ID=1:476274489231:web:fb67e5fde8a5d26328bdfa
# VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Storage for Firebase may require the Blaze plan. Set to "false" to hide
# upload buttons and use image URLs / bundled images instead.
VITE_FILES_GATEWAY_URL=


# Set to "true" ONLY after deploying functions/ (Blaze plan). Enables instant
# server-side CBT grading; otherwise examiners grade from the CBT results page.
VITE_USE_CLOUD_FUNCTIONS=false

# Public base path. GitHub project site = "/<repo-name>/". Custom domain = "/".
VITE_BASE_PATH=/Episteme-Learning-Academy/

# Public site URL (used in sitemap + canonical/OG tags)
VITE_SITE_URL=https://episteme01.github.io/Episteme-Learning-Academy
